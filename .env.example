# ============================================================
# SOCIAL HUB — Environment Configuration
# ============================================================

# Server Port
PORT=4000

# WhatsApp Engine Selection ('openwa' or 'baileys')
WHATSAPP_ENGINE=openwa

# OpenWA WhatsApp API Gateway Configuration (https://github.com/rmyndharis/OpenWA.git)
OPENWA_API_URL=http://localhost:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_NAME=social-hub

# Telegram Bot Configuration
BOT_TOKEN=
CHANNEL_LINK=

# Optional: RapidAPI Key for Instagram Fallback Scraper
RAPIDAPI_KEY=

# Anonymous public YouTube provider (Invidious-compatible API; no browser cookies)
# Use an instance you operate or trust. Example: https://your-invidious.example
INVIDIOUS_API_URL= https://inv.nadeko.net

# Optional: Dedicated Cobalt Downloader Provider (https://github.com/imputnet/cobalt)
COBALT_API_URL=
COBALT_API_KEY=
