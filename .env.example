# ============================================================
# SOCIAL HUB — Environment Configuration
# ============================================================

# Server Port (Social Hub Web Dashboard & API)
PORT=4000

# WhatsApp Engine Selection ('openwa' or 'baileys')
WHATSAPP_ENGINE=openwa

# OpenWA WhatsApp API Gateway Configuration (https://github.com/rmyndharis/OpenWA.git)
OPENWA_API_URL=http://localhost:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_NAME=social-hub

# Telegram Bot Configuration
BOT_TOKEN=
CHANNEL_LINK=

# Optional: RapidAPI Key for Instagram Fallback Scraper
RAPIDAPI_KEY=

# Downloader Provider 1: yt-dlp + BGUTIL PO Token Provider (http://127.0.0.1:4416)
BGUTIL_API_URL=http://127.0.0.1:4416

# Downloader Provider 2: Cobalt Downloader API (http://127.0.0.1:9000)
# Note: Never point this to port 4000 (which belongs to Social Hub)
COBALT_API_URL=http://127.0.0.1:9000
COBALT_API_KEY=

# Downloader Provider 3: Invidious Media Proxy API
INVIDIOUS_API_URL=https://inv.nadeko.net

# Optional: Custom yt-dlp binary path or proxy
YTDLP_PATH=
YTDL_PROXY=
